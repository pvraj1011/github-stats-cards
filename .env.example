# ==============================================================================
# LOCAL TESTING ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to '.env' (which is gitignored) for local development/testing.
#
# IMPORTANT:
# NEVER commit your actual GitHub token to git!
# In GitHub Actions production, GITHUB_TOKEN or GH_PAT will be passed securely
# via GitHub repository secrets.
# ==============================================================================

# Your GitHub Personal Access Token (PAT)
# Scope needed: `read:user` (or fine-grained PAT with public repositories read-only access)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# GitHub username to fetch stats for (defaults to pvraj1011 if unset)
GITHUB_USERNAME=pvraj1011

# Local output directory for generated SVGs (defaults to ./output)
OUTPUT_DIR=./output
